{
  "name": "slopshield",
  "version": "0.1.1",
  "description": "Block AI-hallucinated and typosquatted npm packages before they install.",
  "type": "module",
  "bin": {
    "slopshield": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoi03/slopshield.git"
  },
  "bugs": {
    "url": "https://github.com/khoi03/slopshield/issues"
  },
  "homepage": "https://github.com/khoi03/slopshield#readme",
  "author": "khoi03 (https://github.com/khoi03)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch \"src/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"src/cli.ts\" --test-coverage-exclude=\"src/data/**\" --test-coverage-exclude=\"src/types.ts\" \"src/**/*.test.ts\"",
    "build": "tsup",
    "build:data": "node scripts/build-popular.ts",
    "validate": "node scripts/validate-corpus.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "npm",
    "security",
    "supply-chain",
    "slopsquatting",
    "typosquatting",
    "hallucination",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
